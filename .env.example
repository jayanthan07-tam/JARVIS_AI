# Copy to .env.production.local for a local Windows deployment.
# Keep real values out of Git, browser code, Android resources, and build logs.

# Required before production APIs will respond.
JARVIS_ACCESS_PASSWORD=
JARVIS_AUTH_SECRET=

# Persistent SQLite data. The default stays at ./data/jarvis.db.
JARVIS_DATA_DIR=./data

# Local Ollama stays on the server machine and is not exposed to the network.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional server-side AI provider credentials.
GEMINI_API_KEY=
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL=

# Optional server-side web-search credentials.
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
